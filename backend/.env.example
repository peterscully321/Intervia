PORT=5000
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=

# Firebase project used for identity, Firestore data, and private resume files.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# Local login uses the real Firebase Authentication project by default.
# Set FIREBASE_AUTH_EMULATOR_HOST only when intentionally testing fake local accounts.
FIREBASE_AUTH_EMULATOR_HOST=
# Free local product data and resume storage: start `npm run dev:firebase-emulators` from the repo root.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# This emulator bucket name is local only; use the exact Console bucket name in production.
# Use the same project ID as FIREBASE_PROJECT_ID. Do not set this in production.
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Set this to the local service-account JSON file path, outside the repository.
# On Google-hosted production services, use the platform's managed identity instead.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/intervia-dev-admin.json
# Optional inline JSON alternative. Keep blank when using GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=

GEMINI_API_KEY=
# Optional override for the Gemini Live API model used for real-time coaching.
GEMINI_LIVE_MODEL=gemini-3.8-live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional cold-start fallback if Frankfurter is temporarily unavailable.
USD_INR_RATE=
